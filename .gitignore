# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
apps/console/.next/
apps/console/next-env.d.ts

# Test + coverage output
coverage/
test-results/
playwright-report/

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets and local config — never commit these (CLAUDE.md rule #10)
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Bundled T1 embedding model — fetched by `pnpm --filter extension fetch:model`, not committed.
apps/extension/assets/models/

# Claude Code local state. `worktrees/` holds the parallel-track checkouts described in
# CLAUDE.md § "Parallel tracks": each is a full copy of this repository living inside it, and
# committing one would nest the repository in itself. `settings.local.json` is per-developer.
.claude/worktrees/
.claude/settings.local.json
