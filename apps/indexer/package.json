{
  "name": "indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/crawl/in-page && cp src/crawl/in-page/*.ts dist/crawl/in-page/",
    "browsers:install": "playwright install chromium",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/schema.generated.ts --camel-case --singularize",
    "dev": "OTEL_SERVICE_NAME=wispr-indexer tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "OTEL_SERVICE_NAME=wispr-indexer node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/crawl/in-page/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:observers": "vitest run --config vitest.e2e.config.ts test/e2e/observers.test.ts",
    "test:seed": "vitest run --config vitest.e2e.config.ts test/e2e/seed.test.ts",
    "test:drift": "vitest run --config vitest.e2e.config.ts test/e2e/drift.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-ioredis": "0.56.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "esbuild": "0.28.1",
    "fingerprint": "workspace:*",
    "ioredis": "5.11.1",
    "kysely": "0.29.4",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "playwright": "1.61.0",
    "protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "express": "5.2.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
