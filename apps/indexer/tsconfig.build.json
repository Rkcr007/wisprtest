{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // In-page sources are copied into `dist` as TypeScript by the build script rather than
  // compiled: esbuild is the only thing that reads them, and one form means no stale copy.
  "exclude": ["src/**/*.test.ts", "src/crawl/in-page/**"]
}
