# WisprTest — local environment.
#
# Copy to .env before running `make dev` or `make db-up` (`make db-up` does this for you
# if .env is missing). .env is gitignored and must never be committed — CLAUDE.md rule #10.
#
# Nothing here has a default baked into code. Every service validates its own slice of these
# variables with Zod (Node) or pydantic-settings (Python) at boot and refuses to start when one
# is missing or malformed, rather than silently falling back.

# ─── Shared ──────────────────────────────────────────────────────────────────────────────────
# Selects development-only behaviour (pretty logs, verbose errors). One of: development|test|production
NODE_ENV=development
# Minimum level emitted by every Node service. One of: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# ─── PostgreSQL 16 — memory graph, entity schemas, seed ledger, sessions, audit ──────────────
# Consumed by docker-compose.yml to initialise the container, and by the services to connect.
POSTGRES_USER=wispr
POSTGRES_PASSWORD=wispr_local_dev_only
POSTGRES_DB=wispr
# Host port the container publishes on. Change if 5432 is already taken locally.
POSTGRES_PORT=5432
# Full connection string used by the gateway repository layer and by Atlas migrations.
DATABASE_URL=postgres://wispr:wispr_local_dev_only@localhost:5432/wispr?sslmode=disable

# ─── Redis 7 — hot memory snapshots, crawl job stream, rate limiting ─────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Qdrant — element vectors and alias corpus (per-tenant collections) ──────────────────────
# HTTP/REST port.
QDRANT_PORT=6333
# gRPC port, used by the indexer for bulk upserts.
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# ─── Object storage — session evidence ───────────────────────────────────────────────────────
# Screenshots and DOM snapshots captured on check actions and failures (Phase 12). The database
# holds a reference and a content hash; the bytes live here and are retrieved through short-lived
# signed URLs, so the console never holds a storage credential.
# MinIO locally, S3-compatible, so production is a change of endpoint and keys rather than code.
EVIDENCE_PORT=9000
EVIDENCE_CONSOLE_PORT=9001
EVIDENCE_ENDPOINT=http://localhost:9000
EVIDENCE_BUCKET=wispr-evidence
EVIDENCE_REGION=us-east-1
# Secrets: set them in .env, never commit them. The compose file wires these into MinIO too, so
# the gateway and the storage it talks to cannot drift apart.
EVIDENCE_ACCESS_KEY_ID=wispr-local-dev
EVIDENCE_SECRET_ACCESS_KEY=wispr-local-dev-secret
# How long a retrieval URL stays valid. Short: a link that leaks out of a bug report should stop
# working long before anyone finds it.
EVIDENCE_URL_TTL_SECONDS=300

# ─── Dex — the identity provider ─────────────────────────────────────────────────────────────
# The console is a real OIDC relying party and the gateway is a real resource server; both were
# built and neither could be exercised locally, because nothing in the stack minted tokens. Dex
# fills that hole with an actual OIDC provider backed by a password database — not a mock, and
# not a "skip auth in dev" flag, which would mean the path you drive locally is not the path
# that runs in production. Clients and users are in infra/dex/config.yaml.
#
# The host port is part of the issuer URL, and the issuer is signed into every token as `iss`
# and verified by both services. Changing it here means changing `issuer` in
# infra/dex/config.yaml and OIDC_ISSUER_URL below in the same commit.
DEX_PORT=5556
#
# The fixture users, with their plaintext passwords. They are printed here on purpose: the point
# of a local identity provider is that a developer can sign in, and these authenticate against
# nothing but the Compose stack in this repository. Do not add a real user here.
#
#   priya.lead@northwind.example     priya-local-dev-only     role: lead
#   daniel.tester@northwind.example  daniel-local-dev-only    role: tester
#
# Both addresses match users in db/seed/001_fixture.sql exactly, and that is load-bearing rather
# than tidy: the gateway resolves a verified token to a principal by email and refuses one that
# names nobody it knows, so an unseeded address signs in perfectly and then 401s on every call.
# Run `make db-seed` before expecting either of them to get past the gateway. The two roles sit
# at opposite ends of the permission map, so sign in as Daniel to check that a route is gated
# rather than merely authenticated.

# ─── gateway (Fastify) ───────────────────────────────────────────────────────────────────────
# Bind address. 127.0.0.1 locally; 0.0.0.0 inside a container.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# Upper bound on pooled Postgres connections. Keep the sum across all replicas below the
# server's max_connections (100 by default) or a deploy will exhaust it.
DB_POOL_MAX=10

# OIDC. The issuer and audience are both verified on every token: a validly signed token from
# another provider, or one minted for a different service in the same estate, is still rejected.
# Both values are read by the console too — it is the relying party that obtains the tokens this
# service verifies, and a single .env holds one value for each name, which is what keeps the two
# sides from disagreeing about what a valid token looks like.
#
# The issuer is the Dex service in docker-compose.yml. Point it at your own provider for a
# non-local run; the audience below is the part that needs care when you do.
OIDC_ISSUER_URL=http://localhost:5556/dex
#
# The audience is this service, not the console that calls it. A provider stamps `aud` with the
# id of the client that asked — `wispr-console` — so the naive fix for the resulting 401 is to
# set this to `wispr-console` and move on. Do not: the audience claim is the check that stops a
# token minted for one service being replayed against another, and pointing it at the caller's
# own client id turns "issued for me" into "issued". The mismatch is modelled instead. Dex names
# `wispr-console` a trusted peer of `wispr-gateway` (infra/dex/config.yaml), which authorises the
# console to ask for a token whose audience is this service. Dex mints its access token through
# the same code path as the ID token, so the audience and the `email` claim land on the *access*
# token — the one the console seals into its session cookie and actually sends here.
#
# How a client asks is provider-specific: Auth0 takes an `audience` request parameter, Okta and
# Keycloak use an audience mapper, and Dex uses a scope, `audience:server:client_id:wispr-gateway`.
# The console sends the `audience` parameter, which Dex ignores, and its scope list is fixed in
# code (apps/console/src/auth/oidc.ts), so against Dex it currently receives `aud: wispr-console`
# and this gateway rejects it — correctly. Closing that needs the console to append the
# cross-client scope, which is that module's change to make; the trust relationship it depends on
# is already configured here.
OIDC_AUDIENCE=wispr-gateway
# Optional. Unset means discover it from the issuer's /.well-known/openid-configuration.
# OIDC_JWKS_URI=http://localhost:5556/dex/keys
# Leeway for clock skew between this service and the identity provider, in seconds.
OIDC_CLOCK_TOLERANCE_SECONDS=60

# Extension tokens. The extension cannot be an OIDC client: it has no place to keep a secret, it
# runs inside pages belonging to the application under test, and a browser redirect flow inside a
# tester's working tab is not something to build. So the console — which does hold a real OIDC
# session — asks the gateway to mint a short-lived token for the extension, and the gateway signs
# it with this key rather than with the identity provider's.
#
# A secret, exactly like MODEL_API_KEY above: set it in .env, never commit it, and generate it
# rather than typing it — `openssl rand -base64 32`. It is a signing key, so anything that holds
# it can mint a credential for any tenant; the placeholder below is deliberately not a usable
# value so a deployment that forgot to replace it fails a signature rather than trusting one.
EXTENSION_TOKEN_SIGNING_KEY=replace-me-with-openssl-rand-base64-32
# Lifetime of one of those tokens, in seconds. These are the most exposed credentials in the
# system — they live in a browser extension, on pages the customer's application controls — and
# there is no revocation list, so this number *is* the revocation window: a leaked token stops
# working when it expires and not before. Fifteen minutes keeps that window short while costing
# one silent re-mint per quarter hour of a session, and it sits well inside the tester's working
# session, so nothing has to be re-authorised mid-flow.
EXTENSION_TOKEN_TTL_SECONDS=900

# Rate limiting, per tenant per window — not per process. Backed by Redis so the budget holds
# across replicas rather than multiplying by the number of pods.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# How long in-flight requests may drain on SIGTERM before the pools are closed under them.
SHUTDOWN_TIMEOUT_MS=10000

# T2 escalation model. The extension only reaches this tier when T0 (alias) and T1 (embedding)
# both miss — under 5% of commands — and every successful T2 result writes back an alias so the
# same phrasing is T0 next time. The candidate list is redacted before it ever enters the prompt.
# MODEL_API_KEY is a secret: set it in .env, never commit it. A local run without a real key can
# still serve health and memory; only /v1/resolve/escalate needs it.
MODEL_API_KEY=sk-ant-replace-me
MODEL_BASE_URL=https://api.anthropic.com
# Haiku class: small and fast enough for the 800 ms budget, per CLAUDE.md § "Resolution tiers".
# The fallback is a genuinely different model — a second attempt on the same one answers the same
# way — and is only reached when the primary fails fast, so it must also fit inside what is left
# of the budget. Aliases rather than dated snapshots: the alias tracks the current release.
MODEL_PRIMARY=claude-haiku-4-5
MODEL_FALLBACK=claude-sonnet-5
# Hard ceiling on a single escalation. On timeout the route returns a typed error and the
# extension falls back to disambiguation rather than hanging on a slow model.
MODEL_TIMEOUT_MS=800

# ─── Observability ───────────────────────────────────────────────────────────────────────────
# Service name on every span and metric.
OTEL_SERVICE_NAME=wispr-gateway
# Optional. Unset means spans and metrics are created but not exported, which is the right
# local default — there is no collector in the compose stack until Phase 19.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── indexer (Node + Playwright) ─────────────────────────────────────────────────────────────
# Stable identity for this worker in logs and in the Redis consumer group. Two workers sharing
# one id would each reclaim the other's in-flight crawl, so this must differ per replica.
INDEXER_WORKER_ID=indexer-local-1

# Health endpoint. The indexer serves no API, but /healthz and /readyz are what stop an
# orchestrator from restarting a worker mid-crawl, or leaving a wedged one running.
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8081

# Redis stream carrying CrawlJobs, and the consumer group every replica joins. Both names are
# RELATIVE to the `wispr:` namespace the client applies — writing the prefix in here again would
# address `wispr:wispr:indexer:jobs` and the worker would wait forever on an empty stream.
INDEXER_JOB_STREAM=indexer:jobs
INDEXER_CONSUMER_GROUP=indexers

# How long a read blocks waiting for work before the loop checks whether it should stop.
INDEXER_BLOCK_MS=5000
# How long a delivered job may sit unacknowledged before another worker may claim it. This is the
# resumability lever: a worker that dies holding a job leaves it pending, and after this interval
# a surviving worker takes it over and continues from the last completed route. Too low and two
# workers fight over a live crawl; too high and a crash stalls the queue.
INDEXER_CLAIM_MIN_IDLE_MS=120000
# Progress events retained per job, so a long crawl cannot grow Redis without bound.
INDEXER_PROGRESS_MAXLEN=10000

# Redis stream carrying UiSeedJobs for the UI materializer, and its consumer group. Separate from
# the crawl stream on purpose: a crawl runs for minutes with nobody waiting, while a seed job has
# a tester's request held open behind it, and sharing a stream would queue one behind the other.
# Relative to the `wispr:` namespace, exactly like the crawl stream above.
INDEXER_SEED_STREAM=indexer:seed
INDEXER_SEED_CONSUMER_GROUP=seeders
# How long a seed result waits to be collected. Must exceed the gateway's SEED_MATERIALIZE_TIMEOUT_MS
# so a result outlives the request that asked for it, and not by much: an uncollected result
# describes a record that now exists in a customer's application.
INDEXER_SEED_RESULT_TTL_SECONDS=120

# Redis stream carrying DriftReconcileJobs, and its consumer group. Must equal the gateway's
# DRIFT_JOB_STREAM below. A third stream because a reconcile is the least urgent work this service
# does — the tester was told about the drift immediately and carried on in degraded mode — and
# sharing the seed stream would put a request that is held open behind a background re-crawl.
INDEXER_DRIFT_STREAM=indexer:drift
INDEXER_DRIFT_CONSUMER_GROUP=reconcilers

# Headless everywhere except when you are watching a crawl to debug it. One of: true|false
INDEXER_HEADLESS=true

# Where every tenant's projected secrets live, one subdirectory per tenant id.
#
# This is the fence that makes an auth profile's SecretRef tenant-scoped. A crawl for tenant
# <uuid> may resolve `{provider:'file'}` only to something under <root>/<uuid>/, and
# `{provider:'env'}` only to a variable named WISPR_SECRET_<UUID_WITH_UNDERSCORES>_*.
#
# Without it, a SecretRef is a well-formed reference to any file this process can read — and a
# form auth profile ends by typing the resolved value into a login page the requesting tenant
# controls. Required with no default, so a deployment that skipped it fails at boot instead of
# resolving anything. See apps/indexer/src/crawl/secrets.ts.
#
# Absolute path. In Kubernetes this is where the Secrets Store CSI driver or External Secrets
# projects each tenant's credentials.
INDEXER_SECRET_ROOT=/tmp/wispr-secrets

# Note: the indexer also reads DATABASE_URL, REDIS_URL, DB_POOL_MAX and SHUTDOWN_TIMEOUT_MS from
# the sections above, and sets its own OTEL_SERVICE_NAME in its start script — a single .env
# cannot hold two values for one key, and every service needs its own service name.

# ─── seeding (gateway) ───────────────────────────────────────────────────────────────────────
# Where the gateway reaches the composer. Stateless, so this is the whole of it.
COMPOSER_URL=http://127.0.0.1:8090
# Hard ceiling on one composition call. CLAUDE.md budgets the preview at 1.2 s p95, and a
# composer still thinking past that has already failed the thing the tester is waiting for.
COMPOSER_TIMEOUT_MS=1200
# How long a composed plan is held for approval. The gateway keeps the plan and hands back an id,
# so approval cannot smuggle in an edited record — this is the tester's reading time plus margin.
SEED_PLAN_TTL_SECONDS=300
# How long to wait for the UI materializer. Driving a real form is 3-15 s, and the tester has
# explicitly approved the write. Must stay below INDEXER_SEED_RESULT_TTL_SECONDS.
SEED_MATERIALIZE_TIMEOUT_MS=60000
# The stream SeedJobs are enqueued on. Must equal the indexer's INDEXER_SEED_STREAM, and is
# relative to the `wispr:` namespace for the same reason INDEXER_JOB_STREAM is.
SEED_JOB_STREAM=indexer:seed

# ─── drift (the learning loop) ───────────────────────────────────────────────────────────────
# The stream DriftReconcileJobs are enqueued on. Must equal the indexer's INDEXER_DRIFT_STREAM,
# and is relative to the `wispr:` namespace like the other two.
#
# Its own stream because a reconcile opens a browser for tens of seconds and must not queue
# behind a crawl that runs for minutes. Nothing waits on a reconcile, but a review queue filling
# faster than it drains is still a broken learning loop.
DRIFT_JOB_STREAM=indexer:drift

# Ceiling for one reconcile: navigate one route, extract, re-run the schema observers. Sized for
# a single screen rather than a crawl.
DRIFT_RECONCILE_TIMEOUT_MS=120000

# ─── composer (FastAPI) ──────────────────────────────────────────────────────────────────────
COMPOSER_HOST=127.0.0.1
COMPOSER_PORT=8090

# End-to-end budget for one composition, in milliseconds. CLAUDE.md § "Performance budgets"
# puts the seed preview at 1.2 s p95, and this is the ceiling that number is measured against.
COMPOSE_BUDGET_MS=1200

# Below this schema confidence the composer refuses to compose and names the fields it cannot
# fill, rather than guessing (docs/TEST-DATA-ENGINE.md § 7). A refusal a tester can act on is
# worth more than a record the application rejects for reasons nobody can trace.
COMPOSE_MIN_CONFIDENCE=0.5
#
# The composer also reads MODEL_API_KEY / MODEL_BASE_URL / MODEL_PRIMARY / MODEL_FALLBACK /
# MODEL_TIMEOUT_MS, defined once in the gateway block above. Both services escalate to the
# same provider on the same account; separate names would let them drift onto different models.

# ─── console (Next.js) ───────────────────────────────────────────────────────────────────────
CONSOLE_PORT=3000

# Where the console reaches the gateway. Server-side only — every call the console makes is made
# by the Next server, never by the browser — so the gateway needs no CORS policy for this origin
# and the browser learns nothing about the control plane's topology.
GATEWAY_URL=http://127.0.0.1:8080

# The console as an OIDC relying party. It also reads OIDC_ISSUER_URL and OIDC_AUDIENCE from the
# gateway block above, deliberately: one .env holds one value per name, so the party that obtains
# tokens and the party that verifies them cannot drift apart on what a valid one looks like.
#
# The client id must match a client in infra/dex/config.yaml.
OIDC_CLIENT_ID=wispr-console
# Exact-matched by the provider, and registered in infra/dex/config.yaml as written here. It is
# `${CONSOLE_URL}/auth/callback` — the route at apps/console/app/auth/callback/route.ts — so a
# changed CONSOLE_PORT has to be changed in three places or sign-in fails at the redirect back.
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Left unset: `wispr-console` is registered with Dex as a public client, and PKCE — which the
# console always uses — is what protects the code exchange. A secret distributed through a
# committed example file protects nothing. Set it when the deployment issues a real one.
# OIDC_CLIENT_SECRET=

# Key for the console's session cookie, at least 32 characters. The cookie is encrypted rather
# than signed because it holds a live gateway access token, and a signed cookie is plaintext to
# anyone holding it. A secret like the two above: generate it with `openssl rand -base64 32` and
# keep it out of git. Rotating it signs everyone out, which is the intended behaviour.
CONSOLE_SESSION_SECRET=replace-me-with-openssl-rand-base64-32
