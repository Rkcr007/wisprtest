{
  "name": "gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/db/schema.generated.ts --camel-case --singularize",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run && vitest run --config vitest.db.config.ts && vitest run --config vitest.memory.config.ts && vitest run --config vitest.resolve.config.ts && vitest run --config vitest.sessions.config.ts && vitest run --config vitest.crawl.config.ts",
    "test:crawl": "vitest run --config vitest.crawl.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:memory": "vitest run --config vitest.memory.config.ts",
    "test:resolve": "vitest run --config vitest.resolve.config.ts",
    "test:sessions": "vitest run --config vitest.sessions.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "@aws-sdk/s3-request-presigner": "3.1096.0",
    "@fastify/otel": "0.20.1",
    "@fastify/rate-limit": "11.1.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "fastify": "5.10.0",
    "fingerprint": "workspace:*",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "kysely": "0.29.4",
    "pino": "10.3.1",
    "protocol": "workspace:*",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "kysely-codegen": "0.20.0",
    "pg": "8.16.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
